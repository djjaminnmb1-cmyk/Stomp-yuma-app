{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.stompinyumaapp.uyr5zg",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload step-sheet images for dances",
        "NSPhotoLibraryAddUsageDescription": "Save step-sheet images to your device",
        "NSCameraUsageDescription": "Take step-sheet photos to attach to dances",
        "NSLocationWhenInUseUsageDescription": "Find line-dance events near you",
        "LSApplicationQueriesSchemes": [
          "vnd.youtube",
          "youtube",
          "instagram",
          "fb",
          "fbapiauthlogin",
          "snssdk1233",
          "tiktok"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F2A628"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.stompinyuma.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2A628"
        }
      ],
      "expo-web-browser",
      "expo-audio",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Find line-dance events near you",
          "locationWhenInUsePermission": "Find line-dance events near you",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "privacyPolicyUrl": "https://stompin-yuma-app.preview.emergentagent.com/privacy"
    }
  }
}
