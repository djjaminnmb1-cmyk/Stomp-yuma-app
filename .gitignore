.idea/
.vscode/

# Dependencies
node_modules/
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/
dist

# Environment files (comprehensive coverage)
# SEC-002 (2026-10-05): .env holds SMTP password, JWT signing secret,
# and seed account passwords. One careless `git add .` would publish
# those to history — enumerate every pattern we might ever create.
.env
.env.*
!.env.example
!.env.sample
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
# Also catch the universal patterns people land on:
*.env
!*.env.example
!*.env.sample

*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*pyc*
venv/
.venv/

