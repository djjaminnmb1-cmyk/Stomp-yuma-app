# MongoDB connection string. Example: mongodb://user:pass@host:27017 or mongodb+srv://... . Do NOT commit.
MONGO_URL=""
# MongoDB database name. Preview used "test_database" — production should use a stable name like "stompinyuma".
DB_NAME=<REPLACE_ME>
# Emergent-managed push key (populated automatically on deploy; do not set locally).
EMERGENT_PUSH_KEY=<REPLACE_ME>
# Comma-separated list of instructor emails (bootstraps is_instructor on user creation).
INSTRUCTOR_EMAILS=<REPLACE_ME>
# Comma-separated list of editor emails (can edit dance step sheets).
STEP_SHEET_EDITOR_EMAILS=<REPLACE_ME>
# Shared code that unlocks the instructor role at sign-up. Rotate freely.
INSTRUCTOR_CODE=<REPLACE_ME>
# Random 64+ char secret. Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=<REPLACE_ME>

# SMTP (password reset)
# SMTP server hostname (used for password-reset emails).
SMTP_HOST=<REPLACE_ME>
# SMTP port (usually 587).
SMTP_PORT=<REPLACE_ME>
# SMTP auth username.
SMTP_USERNAME=<REPLACE_ME>
# SMTP auth password. Prefer an app-specific password.
SMTP_PASSWORD=<REPLACE_ME>
# "From" email address for outgoing password-reset mail.
SMTP_FROM=<REPLACE_ME>
# Public URL of the deployed app (used to build reset links).
APP_PUBLIC_URL=""

# Emergent-managed Google Auth (session-exchange endpoint)
# Emergent Google Auth session endpoint. Set by deploy env.
EMERGENT_AUTH_SESSION_URL=""

# Public privacy policy URL (used by app for App Store / Play compliance)
# Public URL of the privacy policy (defaults to APP_PUBLIC_URL/api/legal/privacy).
PRIVACY_POLICY_URL=""

# Seed passwords keep test_credentials.md accurate
# One-time seed password for erinboroughs@gmail.com. Ignored after account exists (SEC-001 fix).
SEED_PW_ERINBOROUGHS_GMAIL_COM=<REPLACE_ME>
SEED_PW_LUVTOWORK247_YAHOO_COM=<REPLACE_ME>
# One-time seed password for admin@stompinground.com. Ignored after account exists.
SEED_PW_ADMIN_STOMPINGROUND_COM=<REPLACE_ME>
# Emergent universal LLM key (populated automatically on deploy).
EMERGENT_LLM_KEY=<REPLACE_ME>

# Sign in with Apple — must include app bundle id + host.exp.Exponent (Expo Go)
# Comma-separated Apple JWT audiences. Example: "com.emergent.stompinyumaapp.uyr5zg,host.exp.Exponent"
APPLE_AUDIENCES=<REPLACE_ME>

# ---- Sign in with Apple — REST (for revoke-on-delete, 5.1.1(v)) ----
# Team ID is REQUIRED for revocation to work. Grab from
# https://developer.apple.com/account → Membership (top-right).
# Apple Developer Team ID (10-char, e.g. 5RVKA62THW).
APPLE_TEAM_ID=<REPLACE_ME>
# Apple Sign In key ID (10-char, matches AuthKey_<KEY_ID>.p8 filename).
APPLE_KEY_ID=<REPLACE_ME>
# Apple Services ID / Bundle ID used for Sign in with Apple (usually the iOS bundle id).
APPLE_CLIENT_ID=<REPLACE_ME>
# Absolute path to the Apple .p8 file inside the running container. Prefer PEM_B64 for production.
APPLE_PRIVATE_KEY_PATH=""
# Base64 of the .p8 — set this on PRODUCTION so we don't need a file on disk
APPLE_PRIVATE_KEY_PEM_B64=<REPLACE_ME>

# ---- CopperKnob API (server-side only) ----
# CopperKnob API key — request from CopperKnob if you need external dance search.
COPPERKNOB_API_KEY=<REPLACE_ME>

# ---- BootStepper API (server-side only) ----
# BootStepper API key — request from BootStepper if you need external dance search.
BOOTSTEPPER_API_KEY=<REPLACE_ME>
